    <!-- Attack types -->
    <string name="attack_l2cap_flood">L2CAP Flood (clásico)</string>
    <string name="attack_l2cap_flood_desc">Inunda conexiones RFCOMM/L2CAP con UUIDs aleatorios y satura el socket.</string>
    <string name="attack_rfcomm_channel_flood">RFCOMM Channel Flood</string>
    <string name="attack_rfcomm_channel_flood_desc">Barre canales RFCOMM 1-30 vía reflexión (API oculta) y satura los sockets conectados.</string>
    <string name="attack_gatt_flood">GATT Flood (BLE)</string>
    <string name="attack_gatt_flood_desc">Llena la tabla de conexiones GATT del periférico BLE para bloquear a su dueño.</string>
    <string name="attack_pairing_flood">Pairing Flood</string>
    <string name="attack_pairing_flood_desc">Inunda al objetivo de solicitudes de emparejamiento (spam de diálogos).</string>
    <string name="attack_sdp_flood">SDP Query Storm</string>
    <string name="attack_sdp_flood_desc">Satura el servidor SDP del objetivo con consultas de servicios repetidas.</string>
    <string name="attack_advertise_flood">Advertising Flood (BLE)</string>
    <string name="attack_advertise_flood_desc">Contamina el canal de anuncios BLE con UUIDs aleatorios.</string>
    <string name="attack_profile_spoof">Profile Spoofing</string>
    <string name="attack_profile_spoof_desc">Se hace pasar por perfiles conocidos (A2DP, HID, HFP…) probando conexión con sus UUIDs.</string>
    <string name="attack_combo">Combo (L2CAP+RFCOMM+GATT+Pairing+SDP)</string>
    <string name="attack_combo_desc">Ataque en capas: L2CAP, RFCOMM, GATT, Pairing y SDP simultáneos sobre el mismo objetivo.</string>

